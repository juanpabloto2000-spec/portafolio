        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "text",
              "value": "=¡Hola {{ $json.client_name }}! ⚡ Te saludamos desde Dynamind Studios.\\n\\nHemos confirmado tu Sesión de Diagnóstico Estratégico 1 a 1 para el próximo *{{ $json.date }}* a las *{{ $json.time }}* (Hora Colombia).\\n\\n🔗 *Enlace de acceso a Google Meet:*\\n{{ $json.meet_link }}\\n\\nEl día de la llamada te enviaremos un recordatorio temprano. ¡Nos vemos pronto para potenciar tu sistema operativo!"
            }
          ]
        },
        "options": {}
      },
      "id": "node-wa-confirm-client",
      "name": "WhatsApp: Confirmación al Cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1380, 320]
