            }
          ]
        },
        "options": {}
      },
      "id": "node-wa-alert-juan",
      "name": "WhatsApp: Alerta a Juan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1620, 320]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-6"
