{
  "name": "Dynamind Studios - Master Automation Ecosystem (Webhooks + AI Agent + Calendar + Daily Reminders)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dynamind-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-lead",
      "name": "Webhook: Lead Web Dynamind",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 240],
      "webhookId": "dynamind-lead-webhook"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Lead recibido y procesado por el búnker de Dynamind\",\n  \"lead_id\": \"{{ $json.body.id }}\"\n}",
        "options": {}
      },
      "id": "node-respond-webhook",
      "name": "Responder 200 OK Inmediato",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [420, 140]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.website_trap || '' }}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "id": "node-filter-bot",
      "name": "¿Es Humano? (Anti-Honeypot)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [420, 320]
    },
    {
      "parameters": {
        "jsCode": "// Normalización y preparación de datos del lead\nconst b = $input.first().json.body;\n\n// Limpieza estricta de teléfono para WhatsApp\nlet rawPhone = (b.phone || '').replace(/[^0-9+]/g, '');\nif (rawPhone.startsWith('3') && rawPhone.length === 10) {\n  rawPhone = '57' + rawPhone; // Asumir Colombia si arranca en 3\n}\nrawPhone = rawPhone.replace('+', '');\n\nconst clientName = b.client_name || 'Innovador';\nconst businessName = b.business_name || 'Negocio Privado';\nconst date = b.date || new Date().toISOString().split('T')[0];\nconst time = b.time || '10:00 AM';\nconst bottleneck = b.bottleneck || 'Optimización operativa y digital';\nconst category = b.category || 'POTENCIAL';\nconst frictionScore = Number(b.friction_score) || 85;\nconst meetLink = b.meet_link || `https://meet.google.com/dyn-${Math.random().toString(36).substring(2, 7)}`;\n\nreturn [{\n  json: {\n    lead_id: b.id || `dyn-${Date.now().toString(36)}`,\n    client_name: clientName,\n    business_name: businessName,\n    phone: rawPhone,\n    niche: b.niche || 'Tecnología & Comercio',\n    bottleneck: bottleneck,\n    friction_score: frictionScore,\n    category: category,\n    date: date,\n    time: time,\n    meet_link: meetLink,\n    reminder_sent: false,\n    confirmed: false,\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-transform-lead",
      "name": "Formatear y Sanitizar Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 320]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "start": "={{ $json.date }} {{ $json.time }}",
        "end": "={{ $json.date }} {{ $json.time }}",
        "additionalFields": {
          "summary": "=⚡ Sesión Estratégica Dynamind: {{ $json.client_name }} ({{ $json.business_name }})",
          "description": "=Diagnóstico de Arquitectura de Software y Cuellos de Botella D0.\\n\\nCliente: {{ $json.client_name }}\\nEmpresa: {{ $json.business_name }}\\nNicho: {{ $json.niche }}\\nWhatsApp: +{{ $json.phone }}\\nScore de Fricción: {{ $json.friction_score }}%\\nCuello de Botella: {{ $json.bottleneck }}\\n\\nEnlace Meet: {{ $json.meet_link }}",
          "conferenceDataUi": {
            "conferenceDataValues": {
              "conferenceSolutionConfig": {
                "solutionType": "hangoutsMeet"
              }
            }
          }
        }
      },
      "id": "node-gcal-create",
      "name": "Google Calendar: Crear Evento & Meet",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [900, 320]
    },
    {
      "parameters": {
        "operation": "upsert",
        "tableId": "appointments",
        "dataMode": "autoMapInputData",
