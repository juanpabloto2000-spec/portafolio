    {
      "parameters": {
        "jsCode": "// Normalización y preparación de datos del lead\nconst b = $input.first().json.body;\n\n// Limpieza estricta de teléfono para WhatsApp\nlet rawPhone = (b.phone || '').replace(/[^0-9+]/g, '');\nif (rawPhone.startsWith('3') && rawPhone.length === 10) {\n  rawPhone = '57' + rawPhone; // Asumir Colombia si arranca en 3\n}\nrawPhone = rawPhone.replace('+', '');\n\nconst clientName = b.client_name || 'Innovador';\nconst businessName = b.business_name || 'Negocio Privado';\nconst date = b.date || new Date().toISOString().split('T')[0];\nconst time = b.time || '10:00 AM';\nconst bottleneck = b.bottleneck || 'Optimización operativa y digital';\nconst category = b.category || 'POTENCIAL';\nconst frictionScore = Number(b.friction_score) || 85;\nconst meetLink = b.meet_link || `https://meet.google.com/dyn-${Math.random().toString(36).substring(2, 7)}`;\n\nreturn [{\n  json: {\n    lead_id: b.id || `dyn-${Date.now().toString(36)}`,\n    client_name: clientName,\n    business_name: businessName,\n    phone: rawPhone,\n    niche: b.niche || 'Tecnología & Comercio',\n    bottleneck: bottleneck,\n    friction_score: frictionScore,\n    category: category,\n    date: date,\n    time: time,\n    meet_link: meetLink,\n    reminder_sent: false,\n    confirmed: false,\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-transform-lead",
      "name": "Formatear y Sanitizar Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
